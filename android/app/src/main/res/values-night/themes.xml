<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Manhwa" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/teal</item>
        <item name="android:colorPrimaryDark">@color/deep</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/deep</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:alertDialogTheme">@style/Theme.Manhwa.Dialog</item>
    </style>

    <style name="Theme.Manhwa.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/teal</item>
    </style>
</resources>
